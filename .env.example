# Copy to .env and fill in. Without keys the app runs in mock mode.

# Image generation + editing (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# TRELLIS.2 image-to-3D via PiAPI (https://piapi.ai)
PIAPI_KEY=
# How the image is sent to PiAPI: datauri | raw (base64). Switch if PiAPI rejects the image.
PIAPI_IMAGE_FORMAT=datauri

# Studio password. Set it before the site is reachable from the internet; client links stay open.
STUDIO_PASSWORD=

# Force a provider: auto | mock | openai / piapi
IMAGE_PROVIDER=auto
MODEL3D_PROVIDER=auto
